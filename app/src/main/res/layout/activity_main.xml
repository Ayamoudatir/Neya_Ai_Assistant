<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".ui.MainActivity">

    <!-- ══ CONTENU PRINCIPAL ══════════════════════════════════════════════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ── Image de fond plein écran ───────────────────────────────── -->
        <ImageView
            android:id="@+id/bgBlurLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/bg_appli"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <!-- ── Contenu principal ─────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- ── Header ────────────────────────────────────────────────── -->
            <FrameLayout
                android:id="@+id/headerBar"
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <View
                    android:id="@+id/headerBlurLayer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp">

                    <ImageButton
                        android:id="@+id/btnMenu"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Menu"
                        android:src="@drawable/ic_menu"
                        android:tint="#F0EAE4" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/app_title"
                        android:fontFamily="@font/space_grotesk"
                        android:textSize="22sp"
                        android:textColor="#F0EAE4"
                        android:letterSpacing="0.04" />

                    <ImageButton
                        android:id="@+id/btnMore"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Plus d'options"
                        android:src="@drawable/ic_more"
                        android:tint="#F0EAE4" />

                </LinearLayout>
            </FrameLayout>

            <!-- ── Avatar ────────────────────────────────────────────────── -->
            <FrameLayout
                android:id="@+id/avatarSection"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3">

                <FrameLayout
                    android:id="@+id/avatarCard"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_card"
                    android:clipToOutline="true">

                    <TextureView
                        android:id="@+id/avatarTextureIdle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="1.0" />

                    <TextureView
                        android:id="@+id/avatarTextureSpeaking"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.0" />

                    <!-- Cadre rose subtil par-dessus la vidéo -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar_frame" />

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/speakingIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/speaking_label"
                        android:textColor="@color/neya_ink"
                        android:textSize="12sp"
                        android:fontFamily="@font/manrope" />

                    <com.example.aistudyassistant_moudatir.ui.view.WaveformView
                        android:id="@+id/waveformView"
                        android:layout_width="120dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </FrameLayout>

            <!-- ── Messages ───────────────────────────────────────────────── -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewChat"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:clipToPadding="false"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                tools:listitem="@layout/item_message_ai" />

            <!-- Erreur réseau -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFEBEE"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textColor="#C62828"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Erreur : impossible de joindre le serveur." />

            <!-- ── Barre de saisie ─────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/inputBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@android:color/transparent"
                android:paddingHorizontal="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdd"
                    style="@style/Widget.Material3.Button.Icon"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:contentDescription="Ajouter"
                    app:cornerRadius="23dp"
                    app:backgroundTint="@color/neya_rose"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:iconSize="22dp"
                    app:iconPadding="0dp"
                    app:iconTint="@color/neya_white" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="8dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusTopStart="24dp"
                    app:boxCornerRadiusTopEnd="24dp"
                    app:boxCornerRadiusBottomStart="24dp"
                    app:boxCornerRadiusBottomEnd="24dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:boxStrokeColor="@color/neya_rose_hot"
                    app:boxStrokeWidth="2dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/neya_rose_hot">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_message"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLines="4"
                        android:imeOptions="actionSend"
                        android:textColor="@color/neya_ink"
                        android:background="@android:color/transparent" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAction"
                    style="@style/Widget.Material3.Button.Icon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:contentDescription="Action"
                    app:cornerRadius="25dp"
                    app:icon="@drawable/ic_mic"
                    app:iconGravity="textStart"
                    app:iconSize="24dp"
                    app:iconPadding="0dp" />

            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

    <!-- ══ SIDEBAR ════════════════════════════════════════════════════════ -->
    <include
        android:id="@+id/navDrawer"
        layout="@layout/nav_drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
