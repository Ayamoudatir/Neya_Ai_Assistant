<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ── Fond dégradé (même que MainActivity) ──────────────────────────── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_app_blur"/>

    <!-- ── Contenu ────────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/settingsContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── Header ──────────────────────────────────────────────────────── -->
        <FrameLayout
            android:id="@+id/settingsHeader"
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#CCF1EAE4"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_back"
                    android:contentDescription="Retour"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Paramètres"
                    android:fontFamily="@font/space_grotesk"
                    android:textSize="20sp"
                    android:textColor="@color/neya_ink"
                    android:letterSpacing="0.04"/>

                <!-- Espace équilibrant le bouton retour -->
                <View
                    android:layout_width="44dp"
                    android:layout_height="44dp"/>

            </LinearLayout>
        </FrameLayout>

        <!-- ── Contenu scrollable ───────────────────────────────────────────── -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="20dp">

                <!-- ════ PROFIL ════════════════════════════════════════════════ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROFIL"
                    android:textSize="11sp"
                    android:letterSpacing="0.12"
                    android:textColor="@color/neya_ink_soft"
                    android:fontFamily="@font/manrope"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_settings_card"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="6dp"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ton prénom"
                        android:textSize="11sp"
                        android:textColor="@color/neya_rose_hot"
                        android:fontFamily="@font/manrope"
                        android:letterSpacing="0.04"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Material3.TextInputLayout.FilledBox"
                        app:boxBackgroundColor="@android:color/transparent"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etUserName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="ex. Sofia"
                            android:inputType="textPersonName|textCapWords"
                            android:textSize="16sp"
                            android:textColor="@color/neya_ink"
                            android:fontFamily="@font/manrope"/>

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- ════ VOIX DE NEYA ══════════════════════════════════════════ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VOIX DE NEYA"
                    android:textSize="11sp"
                    android:letterSpacing="0.12"
                    android:textColor="@color/neya_ink_soft"
                    android:fontFamily="@font/manrope"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_settings_card"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="6dp"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Voix préférée"
                        android:textSize="11sp"
                        android:textColor="@color/neya_rose_hot"
                        android:fontFamily="@font/manrope"
                        android:letterSpacing="0.04"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
                        app:boxBackgroundColor="@android:color/transparent"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp">

                        <AutoCompleteTextView
                            android:id="@+id/actvVoice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textSize="15sp"
                            android:textColor="@color/neya_ink"
                            android:fontFamily="@font/manrope"/>

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- ════ CONNEXION ════════════════════════════════════════════ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONNEXION"
                    android:textSize="11sp"
                    android:letterSpacing="0.12"
                    android:textColor="@color/neya_ink_soft"
                    android:fontFamily="@font/manrope"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_settings_card"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="6dp"
                    android:layout_marginBottom="32dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="URL du serveur"
                        android:textSize="11sp"
                        android:textColor="@color/neya_rose_hot"
                        android:fontFamily="@font/manrope"
                        android:letterSpacing="0.04"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Material3.TextInputLayout.FilledBox"
                        app:boxBackgroundColor="@android:color/transparent"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etServerUrl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="http://10.0.2.2:8000"
                            android:inputType="textUri"
                            android:textSize="14sp"
                            android:textColor="@color/neya_ink"
                            android:fontFamily="@font/manrope"/>

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- ── Bouton Enregistrer ─────────────────────────────────────── -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Enregistrer"
                    android:textSize="16sp"
                    android:fontFamily="@font/manrope"
                    android:letterSpacing="0.04"
                    app:cornerRadius="28dp"
                    app:backgroundTint="@color/neya_rose_hot"
                    android:layout_marginBottom="24dp"/>

                <!-- ── À propos ───────────────────────────────────────────────── -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Neya v1.0  —  Ton assistante personnelle"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:textColor="@color/neya_ink_soft"
                    android:fontFamily="@font/manrope"
                    android:layout_marginBottom="8dp"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
